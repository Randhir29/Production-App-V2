# Every Settings field (app/core/config.py). Placeholders only; copy to .env and edit.
# List values must be JSON, e.g. CORS_ORIGINS=["https://example.org"].

# --- App ---
APP_NAME=ProDash API
APP_ENV=development
DEBUG=false
DOCS_ENABLED=false
API_V1_PREFIX=/api/v1
LEGACY_API_ENABLED=true
LEGACY_PREFIX=/prodash
TIMEZONE=Asia/Kolkata

# --- Central DB (postgresql+psycopg://... or mysql+aiomysql://...) ---
CENTRAL_DATABASE_URL=mysql+aiomysql://localhost:Hpcl@1234@host:3306/prodash
CENTRAL_DB_POOL_SIZE=5
CENTRAL_DB_MAX_OVERFLOW=10
CENTRAL_DB_CONNECT_TIMEOUT_S=10
# LEGACY_MYSQL_URL=mysql+aiomysql://user:password@host:3306/prodash

# --- Plant DBs (PostgreSQL, read-only) ---
PLANT_DB_PORT=5432
PLANT_DB_POOL_SIZE=2
PLANT_DB_MAX_OVERFLOW=3
PLANT_DB_CONNECT_TIMEOUT_S=10
PLANT_DB_STATEMENT_TIMEOUT_MS=120000
PLANT_ENGINE_CACHE_MAX=64
PLANT_ENGINE_TTL_S=3600
PLANT_MAX_CONCURRENCY=4

# --- Static plant config ---
STATIC_PLANT_CONFIG_PATH=config/static_plant_config.yaml

# --- JWT (secret must be >= 32 characters) ---
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ENABLED=true
SERVICE_API_KEYS=[]

# --- HTTP edge ---
CORS_ORIGINS=[]
TRUSTED_PROXIES=[]

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
SLOW_QUERY_MS=5000
